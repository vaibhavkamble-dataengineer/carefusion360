# ============================================================
# CareFusion360 - Git Ignore Rules
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/

# Environment / Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/
config.local.*
aws_credentials*
credentials.json

# AWS / Cloud artifacts
.aws/
cdk.out/
terraform/.terraform/
terraform.tfstate
terraform.tfstate.*
*.tfvars
*.tfvars.json

# Airflow
airflow/logs/
airflow/.astro/
airflow/__pycache__/
*.airflow.db

# Spark
spark-events/
spark-checkpoints/
checkpoints/
*.crc

# Data / Runtime output
data/
raw/
bronze/
silver/
gold/
staging/
curated/
intermediate_data/
quarantine/
tmp/
logs/
audit/
metadata/
*.csv
*.json
*.parquet
*.orc
*.avro

# Keep safe examples/placeholders
!sample_data/.gitkeep

# IDE / Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Temporary files
*.log
*.tmp
*.bak
*.backup

# ------------------------------------------------------------
# Portfolio sample data
# ------------------------------------------------------------
!sample_data/
!sample_data/README.md
!sample_data/input/
!sample_data/input/*.csv
!sample_data/input/*.json
!sample_data/output/
!sample_data/output/*.csv
